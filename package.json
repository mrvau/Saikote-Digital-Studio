{
	"name": "saikote-digital-studio",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev:frontend": "npm run dev --prefix frontend",
		"dev:electron": "wait-on http://localhost:5173 && electron .",
		"dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:electron\"",
		"rebuild:electron": "electron-rebuild -f -w better-sqlite3 --module-dir backend",
		"build:frontend": "npm run build --prefix frontend",
		"build": "npm run build:frontend && npm run rebuild:electron && electron-builder"
	},
	"build": {
		"appId": "com.saikote.digitalstudio",
		"productName": "Saikote Digital Studio",
		"asar": false,
		"files": [
			"electron/**/*",
			"backend/**/*",
			"!backend/studio.db",
			"!backend/studio.db-*",
			"frontend/dist/**/*",
			"build/icon.png"
		],
		"directories": {
			"output": "release"
		},
		"win": { "target": "nsis", "icon": "build/icon.ico" },
		"mac": { "target": "dmg", "icon": "build/icon.icns" },
		"linux": { "target": "AppImage", "icon": "build/icon.png" }
	}
}
